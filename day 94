Write a function that accepts a structure as parameter and prints its members.
  #include <stdio.h>
struct Student {
    char name[50];
    int marks;
};

void printStudent(struct Student s) {
    printf("%s %d\n", s.name, s.marks);
}

int main() {
    struct Student s1 = {"Alice", 90};
    printStudent(s1);
    return 0;
}
